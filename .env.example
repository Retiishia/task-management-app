# Environment variables example for Task Management App

# When running locally on host machine (connecting to localhost MongoDB):
MONGODB_URI=mongodb://localhost:27017/taskdb

# When running inside Docker container (connecting to Docker mongodb service):
# MONGODB_URI=mongodb://mongodb:27017/taskdb

PORT=3000
NODE_ENV=development
JWT_SECRET=fallback_secret_key_vibecoding_learning_task_app

# SMTP Email Configuration — Using Brevo (formerly Sendinblue)
# Sign up free at https://app.brevo.com → SMTP & API → Generate SMTP Key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
EMAIL_USER=your_brevo_login_email@example.com
EMAIL_PASS=your_brevo_smtp_key_here
